---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { active, safeHref } from "../lib/projects";
import { SITE } from "../lib/site";

const nowLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "url": new URL("/now", SITE.url).toString(),
  "name": "Now — Shariq Hirani",
  "description": "What Shariq Hirani is focused on right now.",
};

const tools = [
  { name: "GitHub", icon: "github" },
  { name: "GitHub Copilot", icon: "githubcopilot" },
  { name: "Claude", icon: "claude" },
  { name: "Notion", icon: "notion" },
  { name: "1Password", icon: "1password" },
  { name: "iTerm2", icon: "iterm2" },
  { name: "Obsidian", icon: "obsidian" },
  { name: "Docker", icon: "docker" },
  { name: "Swift", icon: null },
  { name: "TypeScript", icon: null },
  { name: "Astro", icon: null },
  { name: "Cloudflare", icon: null },
  { name: "SQLite", icon: null },
];
const focusNames = new Set(["Oris", "Agent Inbox", "AskDocs"]);
const focusProjects = active.filter((project) => focusNames.has(project.name));
---
<BaseLayout title="Now" description="What Shariq Hirani is working on right now." jsonLd={nowLd}>
  <PageHeader eyebrow="Updated regularly" title="Now" />

  <section class="now-section">
    <span class="mono-label">Building</span>
    <div class="building-list">
      {focusProjects.map((project) => (
        <article class="building">
          <div class="building-head">
            <h2 class="project-name">
              {safeHref(project.site ?? project.repo) ? (
                <a href={safeHref(project.site ?? project.repo)} target="_blank" rel="noopener">{project.name}</a>
              ) : (
                <span>{project.name}</span>
              )}
            </h2>
            {project.status && <span class="project-status">{project.status}</span>}
          </div>
          {project.blurb && <p class="project-blurb">{project.blurb}</p>}
        </article>
      ))}
    </div>
  </section>

  <section class="now-section">
    <span class="mono-label">Writing about</span>
    <ul class="writing-list">
      <li>AI as an operating model, not a side tool</li>
      <li>Local AI products that outlast the demo</li>
      <li>Agent guardrails, review, coordination, and human attention</li>
    </ul>
  </section>

  <section class="now-section" style="border-bottom: none;">
    <span class="mono-label">Tools I reach for</span>
    <div class="stack">
      {tools.map((t) => (
        <span class="tool">
          {t.icon && <i class="tool-ic" style={`--ic: url(/static/icons/${t.icon}.svg)`} aria-hidden="true" />}
          {t.name}
        </span>
      ))}
    </div>
  </section>

  <p class="updated">Last updated August 2026 — <a href="/about">more about me</a></p>
</BaseLayout>

<style>
  .mono-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .2em;
    text-transform: uppercase;
    opacity: .55;
    display: block;
    margin-bottom: 18px;
  }

  .now-section {
    padding: 48px 0;
    border-bottom: 1px solid color-mix(in oklab, var(--fg) 12%, transparent);
  }

  .building-list { display: grid; }
  .building { padding: 20px 0; }
  .building + .building { border-top: 1px dashed color-mix(in oklab, var(--fg) 16%, transparent); }
  .building-head { display: flex; align-items: baseline; justify-content: space-between; gap: 24px; }

  .building .project-name {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 30px;
    letter-spacing: -.02em;
  }

  .building .project-name :is(a, span) {
    color: var(--color-terracotta);
  }

  .building .project-name a {
    text-decoration: underline;
    text-decoration-color: var(--color-ochre);
    text-underline-offset: 5px;
  }

  .project-status {
    flex: none;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--fg-soft);
  }

  .project-blurb {
    margin-top: 6px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--fg-soft);
    max-width: 58ch;
  }

  .writing-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .writing-list li {
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1.4;
    letter-spacing: -.01em;
    padding: 14px 0;
    border-bottom: 1px dashed color-mix(in oklab, var(--fg) 16%, transparent);
  }

  .writing-list li:last-child { border-bottom: none; }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tool {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--fg) 18%, transparent);
  }

  .tool-ic {
    width: 13px;
    height: 13px;
    flex: none;
    background: var(--fg);
    -webkit-mask: var(--ic) center / contain no-repeat;
    mask: var(--ic) center / contain no-repeat;
  }

  .updated {
    margin-top: 40px;
    margin-bottom: 40px;
    font-family: var(--font-mono);
    font-size: 11px;
    opacity: .45;
    letter-spacing: .06em;
  }

  .updated a {
    color: var(--color-terracotta);
    text-decoration: underline;
    text-decoration-color: var(--color-ochre);
    text-underline-offset: 3px;
  }
</style>
